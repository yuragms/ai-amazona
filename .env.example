# Copy to .env.local and fill in values. Do not commit .env or .env.local.

# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_amazona"

# NextAuth (required)
AUTH_SECRET="generate-with-npx-auth-secret"

# Optional: OAuth
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Stripe (required for checkout)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (required for order emails, password reset)
RESEND_API_KEY="re_..."
# SENDER_EMAIL="noreply@yourdomain.com"
# SENDER_NAME="Your Store"

# Uploadthing (required for product image uploads)
UPLOADTHING_TOKEN="base64-json-from-uploadthing-dashboard-v7"

# App URL (optional; default: VERCEL_URL or http://localhost:3000)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
